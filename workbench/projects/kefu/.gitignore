# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
__pycache__/
*.pyc
/dist/
/.wrangler/
/outputs/
/work/
/data/*.sqlite*
/data/*.reviews.lock
/data/review-auth/
/data/metric-auth/
/data/collection-auth/
/data/*.metrics.lock
/data/*.collection.lock
/data/collection-alerts.enc
/data/.collection-alerts.enc.*.tmp
/backups/

# local agent state
/.workbuddy/

# isolated next build output
/.next-build/
/.next-build-*/

# local dev build output
/.next-dev/
