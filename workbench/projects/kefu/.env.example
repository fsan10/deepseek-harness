IMPORT_API_KEY=replace-with-a-long-random-secret
KEFU_DB_PATH=./data/kefu.sqlite
# 复用财务项目的 profile、登录恢复与人工异常处理模块
MOCK_COFFICE_ROOT=D:\fsan10\mock_coffice
# 默认使用 kefu 自身的 .venv，MOCK_COFFICE_ROOT 仅用于共享登录代码
# 可选：覆盖本项目 Python 路径；后台使用同目录下的 pythonw.exe
# REVIEWS_PYTHON=D:\fsan10\kefu\.venv\Scripts\python.exe
# CLOAK_MCP_URL=http://127.0.0.1:19610/mcp
# 加密会话目录，默认 data/review-auth；须保持私有且不提交 Git
# COLLECTION_AUTH_DIR=D:\fsan10\kefu\data\collection-auth
# 旧 REVIEWS_AUTH_DIR / METRICS_AUTH_DIR 仅供迁移已有加密会话，三类采集保存到统一目录
# 多平台指标会话使用同样的 Windows 用户 DPAPI 加密；默认 data/metric-auth
# METRICS_AUTH_DIR=D:\fsan10\kefu\data\metric-auth
# 独立 CLI 入库时的本机服务地址；网页启动的指标 worker 自动使用当前服务端口
# KEFU_IMPORT_BASE_URL=http://127.0.0.1:3000
# 飞书应用、群和共享人工处理服务在「采集设置」页面配置，默认 data/collection-alerts.enc
