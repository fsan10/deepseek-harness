# PostgreSQL 已在目标电脑 Docker 中运行，并向宿主机发布 5432 端口。
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=coffice_production
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# 仅在需要创建 coffice_production 数据库时使用；已存在时可留空。
DATABASE_ADMIN_URL=

# 首次启动创建超级管理员。密码至少12位，需同时包含大小写字母、数字和特殊字符。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INITIAL_ADMIN_DISPLAY_NAME=超级管理员

# 必填：url-safe base64编码的32字节密钥。迁移已有AI密文时必须使用原电脑上的同一密钥。
AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME

# 影刀/自动化 API Bearer Token。自动下载脚本仍留在原电脑，但可调用这里的上传 API。
INGEST_ROBOT_TOKEN=CHANGE_ME_RANDOM_TOKEN
# 自动化验证码转发 API 的 Bearer Token。建议与上传令牌分开生成；原电脑自动化脚本调用验证码接口时使用此值。
# 服务端未设置此值时会兼容回退到 INGEST_ROBOT_TOKEN，但正式环境应显式配置。
AUTOMATION_ROBOT_TOKEN=CHANGE_ME_RANDOM_AUTOMATION_TOKEN
INGEST_FILE_ROOT=/app/.uploads/file_ingest
INGEST_MAX_UPLOAD_MB=200

# DataEase 已在目标电脑 Docker 中运行，并向宿主机发布8100端口。
DATAEASE_BASE_URL=http://host.docker.internal:8100
DATAEASE_PUBLIC_ORIGINS=http://192.168.77.111:8100
DATAEASE_PROXY_BIND=0.0.0.0
DATAEASE_PROXY_PORT=8101
DATAEASE_PROXY_PUBLIC_URL=http://192.168.77.111:8101

# 内网HTTP部署保持false；配置HTTPS反向代理后改为true。
AUTH_COOKIE_SECURE=false
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=8
AUTH_FAILURE_LIMIT=5
AUTH_LOCK_MINUTES=15
AUTH_BCRYPT_ROUNDS=12

# 飞书配置由数据库AI管理页面维护。未启用飞书长连接时保持false。
FEISHU_AI_LONG_CONNECTION_ENABLED=false

# 每日全量ETL调度时间。
TZ=Asia/Shanghai

WEB_PORT=8770
APP_IMAGE_TAG=2026.08.19
