{
  "schema_version": 1,
  "common": {
    "capture_resource_types": [
      "XHR",
      "Fetch",
      "Preflight",
      "Document",
      "Other",
      "EventSource",
      "WebSocket",
      "Script"
    ],
    "ignore_resource_types": [
      "Image",
      "Media",
      "Font",
      "Stylesheet"
    ],
    "ignore_extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".avif",
      ".svg",
      ".ico",
      ".bmp",
      ".mp3",
      ".wav",
      ".aac",
      ".flac",
      ".mp4",
      ".webm",
      ".m3u8",
      ".ts",
      ".woff",
      ".woff2",
      ".ttf",
      ".otf",
      ".eot",
      ".css",
      ".js",
      ".map"
    ],
    "exclude_domains": [
      "google-analytics.com",
      "googletagmanager.com",
      "doubleclick.net",
      "sentry.io",
      "hm.baidu.com"
    ],
    "exclude_url_regex": [
      "(?i)/favicon(?:\\.|/)",
      "(?i)/sockjs-node(?:/|$)"
    ]
  },
  "platforms": {
    "generic": {
      "description": "捕获当前浏览器全部非静态 HTTP 请求；用于未知平台或排查过滤遗漏",
