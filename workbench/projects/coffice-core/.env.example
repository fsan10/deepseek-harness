# mock_coffice 项目环境配置模板
# 请将本文件复制为 .env，并仅在本机替换 CHANGE_ME 占位值。
# 禁止提交 .env，也不要在本模板中填写真实敏感信息。

# 运行环境：测试环境使用 mock_coffice；正式部署必须使用 coffice_production。
COFFICE_ENV=test

# ETL、经营配置中心和 Docker 服务使用的 PostgreSQL 连接配置。
PGHOST=192.168.77.111
PGPORT=5432
PGDATABASE=mock_coffice
PGUSER=postgres
PGPASSWORD=CHANGE_ME_DATABASE_PASSWORD
PGMAINTENANCE_DB=postgres

# 仅供数据库创建和环境切换工具使用的可选数据库连接串。
DATABASE_ADMIN_URL=
TEST_DATABASE_URL=
PRODUCTION_DATABASE_URL=

# 首次启动时创建的管理员。首次登录成功后应删除 INITIAL_ADMIN_PASSWORD。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INITIAL_ADMIN_DISPLAY_NAME=超级管理员

# 启用 AI 配置加密时必填。请使用长度为 32 字节、经过 URL 安全 Base64 编码的密钥。
AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME_URLSAFE_BASE64_32_BYTE_KEY

# 文件导入 API 和自动化 API 使用的 Bearer 令牌。正式环境请分别生成随机值。
INGEST_ROBOT_TOKEN=CHANGE_ME_RANDOM_INGEST_TOKEN
AUTOMATION_ROBOT_TOKEN=CHANGE_ME_RANDOM_AUTOMATION_TOKEN
INGEST_FILE_ROOT=.uploads/file_ingest
INGEST_MAX_UPLOAD_MB=200

# DataEase 嵌入和代理配置。
DATAEASE_BASE_URL=http://<替换成实际IP>:8100
DATAEASE_PUBLIC_ORIGINS=http://<替换成实际IP>:8100
DATAEASE_PROXY_BIND=127.0.0.1
DATAEASE_PROXY_PORT=8101
DATAEASE_PROXY_PUBLIC_URL=http://127.0.0.1:8101

# 认证和访问频率限制配置。
AUTH_COOKIE_SECURE=false
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=8
AUTH_FAILURE_LIMIT=5
AUTH_LOCK_MINUTES=15
DEFAULT_INITIAL_PASSWORD=CHANGE_ME_DEFAULT_INITIAL_PASSWORD
AUTH_BCRYPT_ROUNDS=12
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_USER_IP_LIMIT=5
AUTH_LOGIN_RATE_IP_LIMIT=20
AUTH_LOGIN_RATE_COOLDOWN_SECONDS=60

# AI 请求限制配置。
AI_MAX_ANALYSIS_SECONDS=180
AI_MAX_CONTEXT_CHARS=40000
AI_USER_REQUESTS_PER_MINUTE=10
AI_DEPARTMENT_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENT_PER_USER=2
AI_MAX_CONCURRENT_PER_DEPARTMENT=10

# 后台调度配置。
FEISHU_AI_LONG_CONNECTION_ENABLED=false
TZ=Asia/Shanghai

# Web 服务和部署配置。
WEB_PORT=8770
APP_IMAGE_TAG=latest

# 可选测试开关；除非测试明确需要，否则保持关闭。
RUN_DB_TESTS=0
RUN_DB_INTEGRATION=0
RUN_HTTP_TESTS=0
HTTP_TEST_BASE=http://127.0.0.1:8771
HTTP_TEST_USERNAME=
HTTP_TEST_PASSWORD=
XHS_ENFORCE_BASELINE=0

# 电商账户密码
TMALL_LOGIN_PASSWORD=
TMALL_IT_LOGIN_PASSWORD=

# 标准报表归档后的 API 上传地址；认证沿用 INGEST_ROBOT_TOKEN
INGEST_API_BASE_URL=http://127.0.0.1:8770

# 人工终端上传：仅读取到当前进程，也可使用file_ingest.cli交互登录
INGEST_USERNAME=
INGEST_PASSWORD=
INGEST_BASE_URL=http://127.0.0.1:8770
